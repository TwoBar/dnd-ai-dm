# API Keys
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Model Configuration
OPENAI_MODEL=gpt-4o
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Agent Provider (which LLM to use)
AGENT_PROVIDER=openai  # "openai" or "anthropic"

# Embedding Configuration
EMBEDDING_PROVIDER=openai  # "openai" or "local"
OPENAI_EMBEDDING_MODEL=text-embedding-3-small  # or "text-embedding-3-large"

# Database Paths (auto-configured, no need to change)
REFERENCE_DB_PATH=./data/reference.db
GAME_STATE_DB_PATH=./data/game_state.db
VECTOR_DB_PATH=./data/vector_dbs
SRD_PATH=./data/srd

# Logging
LOG_LEVEL=INFO
